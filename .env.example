# Copy this file to .env and fill it in; `make run` loads it and git ignores .env.
# Make reads these lines: no quotes, and no # or $ in values (pick a password without them).
# Leave RESEND_API_KEY and SMTP_HOST empty to not send anything: emails are printed in the terminal instead.
# Use Resend (HTTPS) on hosts that block SMTP, like Render's free plan; it wins if both are set.

SITE_URL=http://localhost:8080
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=The Cellar <you@example.com>

# Only when deployed behind a proxy, so rate limits see each visitor's real address:
# Render: X-Forwarded-For   Fly.io: Fly-Client-IP   Cloudflare: CF-Connecting-IP
CLIENT_IP_HEADER=
